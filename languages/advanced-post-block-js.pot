#: src/admin/utils/data.js:112
msgid ""
"Select the layout from - <strong>Grid</strong>, <strong>Grid 1</strong>, "
"<strong>Masonry</strong>, <strong>Slider</strong>, <strong>Ticker</strong>, "
"<strong>News Ticker</strong>, <strong>Accordion</strong>, <strong>Magazine "
"1</strong>, <strong>Magazine 2</strong>, or <strong>Timeline</strong>. "
"Switching layouts is non-destructive; your query settings are preserved."
